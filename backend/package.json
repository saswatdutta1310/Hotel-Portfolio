{
  "name": "backend",
  "version": "1.0.0",
  "description": "Hotel portfolio backend API",
  "main": "dist/server.js",
  "type": "module",
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "prestart": "node -e \"const { getAllHotels } = await import('./dist/services/hotel-loader.js'); getAllHotels();\"",
    "build": "tsc",
    "start": "node dist/server.js",
    "lint": "eslint src/ tests/ scripts/",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "validate:hotels": "tsx scripts/validate-hotels.ts",
    "new:hotel": "tsx scripts/new-hotel.ts"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.7.5",
    "helmet": "^7.1.0",
    "nodemailer": "^10.6.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.1.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.12.7",
    "@types/nodemailer": "^8.0.2",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.1.1",
    "supertest": "^6.3.4",
    "tsx": "^4.7.2",
    "typescript": "^5.4.5",
    "typescript-eslint": "^7.8.0",
    "vitest": "^1.5.0"
  }
}
